# Heating agent configuration (/opt/kurenie/config.env)
# After a change:  systemctl restart kurenie-agent kurenie-web

# Key from https://openrouter.ai/keys  (paste after the = sign, without quotes)
OPENROUTER_API_KEY=

# OpenRouter model (cheap options: anthropic/claude-haiku-5.5, google/gemini-2.5-flash-lite)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Fallback model: used once when the main model fails (server error 5xx/429, timeout, invalid JSON).
# Empty = fallback model disabled. A key/credit error (401/402) is not retried.
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# Address of the m5stack-tc ESP module
ESP_URL=http://192.168.1.199

# Approximate location for the weather forecast (open-meteo.com, rounded to 0.1°). Empty = no forecast.
LAT=48.1
LON=17.1

# How often the agent runs (minutes)
INTERVAL_MIN=60

# Longest pause between model calls (hours, 1-12). In between, the agent runs "routinely" without the model
# and calls the model earlier only when something changes (a message, an intervention, a temperature deviation, an error...).
LLM_MAX_GAP_H=4

# Notifications: Home Assistant webhook URL (POST JSON {"title","message","kind"}). Empty = notifications disabled.
# E.g. http://homeassistant.local:8123/api/webhook/<secret-id>
NOTIFY_URL=

# Language of phone notifications, agent assessments and messages, the weekly summary and sensor names in Home Assistant (sk or en).
# The language of the web UI itself is switched in the top bar; this one is changed in the web UI under Settings ("Language of notifications and the agent").
UI_LANG=sk

# Home Assistant: the agent reads window and door contacts from there (read-only, nothing is written to HA).
# HA address (translated to the LAN address from the LXC). The token is entered in the web UI under Settings -> Home Assistant;
# you do not need to type it here by hand. Create it in HA: profile -> Security -> Long-lived access tokens.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
# Prítomnosť pre režim „Preč z domu“ (entity_id group/person/zone, čiarkou; prázdne = bez automatiky)
HA_PRITOMNOST=

# Database cleanup (backup.sh): one-minute samples in tc.db older than this number of days are reduced to a 5-minute grid.
RETENTION_FULL_DAYS=60

# Statistics: a separate SQLite database (permanent hourly data, never cleaned up). Empty = ROOT/stats.db.
STATS_DB=

# Statistics: base for heating degree days (HDD) = the temperature below which the house is heated (10 to 25 °C), default 18.
STATS_HDD_BASE=18

# Dry-run mode: 1 = nothing is sent to the ESP or to the webhook (log entries only). Leave at 0 for live operation.
DRY_RUN=0

WEB_PORT=80

# Controlling room sensor outage: after this many minutes without a temperature from the sensor the room regulation follows
# (or with the status "Čakám na teplotu") the agent shows a warning and sends one notification (plus one when data returns). 0 = off.
CIDLO_STALE_MIN=60

# Weekly heating summary (previous Mon-Sun: room temperatures, spread, energy, COP, starts, agent changes). Sent as notification kind
# "suhrn" to admin devices and shown in the web (Analyses). SUHRN=0 disables; SUHRN_DEN 1=Monday..7=Sunday; SUHRN_HODINA local hour.
# If the agent was down at that hour the summary is sent later the same week (once per week). With an API key and mode != off a short
# model recommendation is appended.
SUHRN=1
SUHRN_DEN=1
SUHRN_HODINA=8
